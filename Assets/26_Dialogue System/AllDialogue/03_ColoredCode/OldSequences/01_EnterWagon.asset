  _lines:
  - _clip: {fileID: 8300000, guid: 2212ec242ef602f4fb3c489b5cd6708f, type: 3}
    _segments:
    - _text: 'Oh yesss! This is one of my favorites, '
      _percentAlongAudioToShow: 0
    - _text: 'but I keep forgetting the solution. '
      _percentAlongAudioToShow: 0.32370377
    - _text: Dave, help me out, what do they have to do again?
      _percentAlongAudioToShow: 0.5395055
  - _clip: {fileID: 8300000, guid: 7c453a87dba85614ebc56d79cca5c01c, type: 3}
    _segments:
    - _text: "It's been so long since I\u2019ve designed that one, "
      _percentAlongAudioToShow: 0
    - _text: let me check my notes
      _percentAlongAudioToShow: 0
  - _clip: {fileID: 8300000, guid: cc03cfab211f7dc428098dfb65569a53, type: 3}
    _segments:
    - _text: "Oh no, it seems I forgot them at the studio\u2026"
      _percentAlongAudioToShow: 0
