  _lines:
  - _clip: {fileID: 8300000, guid: 8e4ef5b3ea662bd43818635935dead4f, type: 3}
    _segments:
    - _text: "There we go, placed them into one of the old carts\r"
      _percentAlongAudioToShow: 0
  - _clip: {fileID: 8300000, guid: ac98b39c2c14f8d4082a58fb954b9ccf, type: 3}
    _segments:
    - _text: "Ahh, you\u2019re an Angel! \r\n"
      _percentAlongAudioToShow: 0
    - _text: 'For a moment I thought we could end the test right here. '
      _percentAlongAudioToShow: 0.16588452
    - _text: '

        Oh wait, but how are they going to learn about the story
        without a proper intro?'
      _percentAlongAudioToShow: 0.5210481
  - _clip: {fileID: 8300000, guid: 60665dd0cfdf70b4093bdd637dc28370, type: 3}
    _segments:
    - _text: "Don\u2019t worry I got that covered already. "
      _percentAlongAudioToShow: 0
    - _text: 'See that note on the table? '
      _percentAlongAudioToShow: 0.31145993
    - _text: "I\u2019ve put all info they need on there"
      _percentAlongAudioToShow: 0.56896746
