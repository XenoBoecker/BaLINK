  _lines:
  - _clip: {fileID: 8300000, guid: c2465af4ed090c54e9eebf274efb98bc, type: 3}
    _segments:
    - _text: "Shouldn\u2019t the intro be playing now?\r\n"
      _percentAlongAudioToShow: 0
  - _clip: {fileID: 8300000, guid: 9e15473ef47122547a6e1d5c06f1e58e, type: 3}
    _segments:
    - _text: "Yes I think it should\u2026 "
      _percentAlongAudioToShow: 0
    - _text: 'but where is it?

'
      _percentAlongAudioToShow: 0.43934047
  - _clip: {fileID: 8300000, guid: dacfa730fdecbc3428babddb177ef328, type: 3}
    _segments:
    - _text: "I don\u2019t know, "
      _percentAlongAudioToShow: 0
    - _text: "but you\u2019ve set the start scene to the intro one right?\r\n"
      _percentAlongAudioToShow: 0.2430504
  - _clip: {fileID: 8300000, guid: c0c0d589e4425b74a92fd8fdf301c3ba, type: 3}
    _segments:
    - _text: 'What do you mean? '
      _percentAlongAudioToShow: 0
    - _text: "That wasn\u2019t my job, was it?\r\n"
      _percentAlongAudioToShow: 0.25666168
  - _clip: {fileID: 8300000, guid: c37812ae04c8e514e9f16ac9fea93d0c, type: 3}
    _segments:
    - _text: Yes it was! Look here
      _percentAlongAudioToShow: 0
  - _clip: {fileID: 8300000, guid: deab04fceec3afc41ae35b757f1422d3, type: 3}
    _segments:
    - _text: "Oh damn, I\u2019m so sorry! "
      _percentAlongAudioToShow: 0
    - _text: 'Let me quickly fix it

'
      _percentAlongAudioToShow: 0.44166312
