  - _clip: {fileID: 8300000, guid: dd5837fd4fc0f19408a7b18d1eac549e, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: "Wait... \r"
      _percentAlongAudioToShow: 0
    - _text: "Trish, I don't recognize this wagon\u2026"
      _percentAlongAudioToShow: 0.04272985
    - _text: "OH! I\u2019ve been waiting for this one!\r"
      _percentAlongAudioToShow: 0.14110787
    - _text: Why?
      _percentAlongAudioToShow: 0.24942309
    - _text: Because of the new Crossbow feature.
      _percentAlongAudioToShow: 0.2951341
    - _text: 'THE WHAT? '
      _percentAlongAudioToShow: 0.3766189
    - _text: 'The awesome Sci-Fi Crossbow. '
      _percentAlongAudioToShow: 0.4223299
    - _text: You know,
      _percentAlongAudioToShow: 0.48493412
    - _text: every good game needs an action sequence.
      _percentAlongAudioToShow: 0.541576
    - _text: 'But how does a SciFi crossbow fit into our game? '
      _percentAlongAudioToShow: 0.6339917
    - _text: That makes no sense!
      _percentAlongAudioToShow: 0.7939803
    - _text: "But whatever, just make sure they\u2019re done quickly, okay?"
      _percentAlongAudioToShow: 0.8585718
