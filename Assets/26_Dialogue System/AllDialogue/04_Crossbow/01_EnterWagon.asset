  _lines:
  - _clip: {fileID: 8300000, guid: dd5837fd4fc0f19408a7b18d1eac549e, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: "Wait... \r"
      _percentAlongAudioToShow: 0
    - _text: "Trish, I don't recognize this wagon\u2026"
      _percentAlongAudioToShow: 0.034677587
    - _text: "OH! I\u2019ve been waiting for this one!\r"
      _percentAlongAudioToShow: 0.1402866
    - _text: Why?
      _percentAlongAudioToShow: 0.2592938
    - _text: Because of the new Crossbow feature.
      _percentAlongAudioToShow: 0.3065814
    - _text: 'THE WHAT? '
      _percentAlongAudioToShow: 0.40115663
    - _text: 'The awesome Sci-Fi Crossbow. '
      _percentAlongAudioToShow: 0.4381986
    - _text: You know,
      _percentAlongAudioToShow: 0.5209519
    - _text: every good game needs an action sequence.
      _percentAlongAudioToShow: 0.5666633
    - _text: 'But how does a SciFi crossbow fit into our game? '
      _percentAlongAudioToShow: 0.65650976
    - _text: That makes no sense!
      _percentAlongAudioToShow: 0.80940646
    - _text: "But whatever, just make sure they\u2019re done quickly."
      _percentAlongAudioToShow: 0.8543297
