--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8a3a9ef48355cb440936a05a37111157, type: 3}
  m_Name: 03_ColorChanges
  m_EditorClassIdentifier: 
  _defaultDelayBetweenLines: 0
  _lines:
  - _clip: {fileID: 8300000, guid: 3ca7d1e9d2a548c4c961c62057f45141, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: 'Wait, did you change anything else? '
      _percentAlongAudioToShow: 0
    - _text: "The wire colors seem wrong\u2026 \r"
      _percentAlongAudioToShow: 0.4450825
  - _clip: {fileID: 8300000, guid: 1cc714734fa63c74f842af89f0ff71ac, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: "No, they are all green like they were supposed to be, right?\r"
      _percentAlongAudioToShow: 0
  - _clip: {fileID: 8300000, guid: 344bb2e6dc91dd64d88045988ce17d71, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: 'No no noo, we said that they should be red, blue and green '
      _percentAlongAudioToShow: 0
    - _text: 'so the player can tell them better apart. '
      _percentAlongAudioToShow: 0.33128875
    - _text: Scoot over and let me fix that.
      _percentAlongAudioToShow: 0.6189181
  - _clip: {fileID: 8300000, guid: b459fa050dd1f044a9a47fa54db48c9f, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: "I\u2019m pretty sure we agreed on all being one color "
      _percentAlongAudioToShow: 0
    - _text: 'because it would be too easy with 3 colors. '
      _percentAlongAudioToShow: 0.28506207
    - _text: "If you don\u2019t like blue we can go with red, "
      _percentAlongAudioToShow: 0.54893667
    - _text: that's fine with me.
      _percentAlongAudioToShow: 0.80510926
  - _clip: {fileID: 8300000, guid: dc1fcceec0724f645abd3374fec60a4b, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: 'Ahhh but what bomb has blue wires? '
      _percentAlongAudioToShow: 0
    - _text: "It\u2019s always red or green\r"
      _percentAlongAudioToShow: 0.4019188
  - _clip: {fileID: 8300000, guid: b6d8fa8812507064b9026ca2c34f3e60, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: "Fine let's take red then\r"
      _percentAlongAudioToShow: 0
  - _clip: {fileID: 8300000, guid: 1f078fe8ec70c7547894e6342aeb9b99, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: 'Oh wait, red was a bad call. '
      _percentAlongAudioToShow: 0
    - _text: 'We already have so much red in the environment, it''s too hard to see

'
      _percentAlongAudioToShow: 0.30515707
  - _clip: {fileID: 8300000, guid: ea52704d52edb84429fb6a67595d137d, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: "So we are back to all green then?\r"
      _percentAlongAudioToShow: 0
