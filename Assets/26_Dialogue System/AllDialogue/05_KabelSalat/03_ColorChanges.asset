  _lines:
  - _clip: {fileID: 8300000, guid: 3ca7d1e9d2a548c4c961c62057f45141, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: Wait...
      _percentAlongAudioToShow: 0
    - _text: Did you change anything else?
      _percentAlongAudioToShow: 0.22543415
    - _text: "The colors of the diffuse wires seem wrong\u2026 "
      _percentAlongAudioToShow: 0.60260284
  - _clip: {fileID: 8300000, guid: 1cc714734fa63c74f842af89f0ff71ac, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: "No, it\u2019s exactly what we\u2019ve said.\r\r"
      _percentAlongAudioToShow: 0
    - _text: No no noo!
      _percentAlongAudioToShow: 0.45715657
    - _text: We said that they should have different colors.
      _percentAlongAudioToShow: 0.59161437
  - _clip: {fileID: 8300000, guid: 344bb2e6dc91dd64d88045988ce17d71, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: No, I'm sure we said all get the same color.
      _percentAlongAudioToShow: 0
  - _clip: {fileID: 8300000, guid: b459fa050dd1f044a9a47fa54db48c9f, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: "No we definitely...\r"
      _percentAlongAudioToShow: 0
    - _text: "whatever...\r"
      _percentAlongAudioToShow: 0.24778372
    - _text: But then not this color!
      _percentAlongAudioToShow: 0.49556744
    - _text: "Fine let's pick something else.\r"
      _percentAlongAudioToShow: 0.6982996
  - _clip: {fileID: 8300000, guid: dc1fcceec0724f645abd3374fec60a4b, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: Oooh nope...
      _percentAlongAudioToShow: 0
    - _text: That one is awful!
      _percentAlongAudioToShow: 0.37004775
    - _text: Then how about this one?
      _percentAlongAudioToShow: 0.7011431
  - _clip: {fileID: 8300000, guid: b6d8fa8812507064b9026ca2c34f3e60, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: Hmm... nah...
      _percentAlongAudioToShow: 0
    - _text: Too confusing!
      _percentAlongAudioToShow: 0.32838404
    - _text: 'What? '
      _percentAlongAudioToShow: 0.5035222
    - _text: "Ok, you\u2019re the designer"
      _percentAlongAudioToShow: 0.6859578
  - _clip: {fileID: 8300000, guid: 1f078fe8ec70c7547894e6342aeb9b99, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: 'Uh... '
      _percentAlongAudioToShow: 0
    - _text: How about this one?
      _percentAlongAudioToShow: 0.36355892
  - _clip: {fileID: 8300000, guid: ea52704d52edb84429fb6a67595d137d, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: 'Ouh I... I take that back, that is horrendous! '
      _percentAlongAudioToShow: 0
    - _text: "We need something else\u2026"
      _percentAlongAudioToShow: 0.66370267
