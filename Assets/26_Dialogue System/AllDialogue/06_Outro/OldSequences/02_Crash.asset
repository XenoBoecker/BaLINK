  _lines:
  - _clip: {fileID: 8300000, guid: 3de62b5c2d5401d47bcc1498cd11ddd5, type: 3}
    _segments:
    - _text: "Oh oh I think the game crashed when you tried to fix the timer. \r"
      _percentAlongAudioToShow: 0
  - _clip: {fileID: 8300000, guid: d81bf2c40062c1d46824f6c144f3d5f4, type: 3}
    _segments:
    - _text: "Okeh thats crazy, I don\u2019t know why it would do that\r"
      _percentAlongAudioToShow: 0
  - _clip: {fileID: 8300000, guid: 456165bb2e83d09498081a4ef51cfd5d, type: 3}
    _segments:
    - _text: "Well, it doesn\u2019t matter now, "
      _percentAlongAudioToShow: 0
    - _text: "cut to the end screen and we\u2019ll fix that bug later.\r"
      _percentAlongAudioToShow: 0
  - _clip: {fileID: 8300000, guid: 2e28d137231fb414a955f8313dde64b7, type: 3}
    _segments:
    - _text: "That was such a great test!\r"
      _percentAlongAudioToShow: 0
  - _clip: {fileID: 8300000, guid: 39e16e09a7a9c094b89bc56e04ae2b62, type: 3}
    _segments:
    - _text: "It was horrendous.\r"
      _percentAlongAudioToShow: 0
