  _defaultDelayBetweenLines: 0
  _lines:
  - _clip: {fileID: 8300000, guid: 2eadc080e4070f84390e5d6c8e2dae7c, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: 'Hey Dave, '
      _percentAlongAudioToShow: 0
    - _text: "don\u2019t be alarmed but the timer didn\u2019t stop."
      _percentAlongAudioToShow: 0.039358467
    - _text: 'EXCUSE ME?! '
      _percentAlongAudioToShow: 0.11235053
    - _text: "You\u2019re saying the timer didn\u2019t stop "
      _percentAlongAudioToShow: 0.14025928
    - _text: "but I shouldn\u2019t be alarmed about it?!? "
      _percentAlongAudioToShow: 0.21468255
    - _text: 'Relax Dave, '
      _percentAlongAudioToShow: 0.26048148
    - _text: "it\u2019s just a number at the top of the screen..."
      _percentAlongAudioToShow: 0.3027024
    - _text: 'IT''S NOT! '
      _percentAlongAudioToShow: 0.35494182
    - _text: "It\u2019s essential for suspense & tension. "
      _percentAlongAudioToShow: 0.37712568
    - _text: It very much is the heartbeat of our game!
      _percentAlongAudioToShow: 0.45011777
    - _text: "Sure sure, I\u2019m already working on fixing it, "
      _percentAlongAudioToShow: 0.5281191
    - _text: now please calm down!
      _percentAlongAudioToShow: 0.60826725
    - _text: "DON\u2019T TELL ME TO CALM DOWN!"
      _percentAlongAudioToShow: 0.64547884
    - _text: 'THIS IS A SERIOUS ISSUE '
      _percentAlongAudioToShow: 0.69414026
    - _text: THAT COULD AFFECT THE RESULT OF THE ENTIRE TEST
      _percentAlongAudioToShow: 0.754967
    - _text: There we go.
      _percentAlongAudioToShow: 0.8172249
    - _text: I just had to set a maximum check on some values and fix some conditions
      _percentAlongAudioToShow: 0.8494273
