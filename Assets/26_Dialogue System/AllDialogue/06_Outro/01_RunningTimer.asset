  - _clip: {fileID: 8300000, guid: 2eadc080e4070f84390e5d6c8e2dae7c, type: 3}
    _delayAfterPlayingLine: 0
    _segments:
    - _text: 'Hey Dave, '
      _percentAlongAudioToShow: 0
    - _text: "don\u2019t be alarmed but the timer didn\u2019t stop."
      _percentAlongAudioToShow: 0.044735342
    - _text: 'EXCUSE ME?! '
      _percentAlongAudioToShow: 0.124619894
    - _text: "You\u2019re saying the timer didn\u2019t stop "
      _percentAlongAudioToShow: 0.16056794
    - _text: "but I shouldn\u2019t be alarmed about it?!? "
      _percentAlongAudioToShow: 0.23805593
    - _text: 'Relax Dave, '
      _percentAlongAudioToShow: 0.29237744
    - _text: "it\u2019s just a number at the top of the screen..."
      _percentAlongAudioToShow: 0.33631393
    - _text: 'IT''S NOT! '
      _percentAlongAudioToShow: 0.3922331
    - _text: "It\u2019s essential for suspense & tension. "
      _percentAlongAudioToShow: 0.41220427
    - _text: It very much is the heartbeat of our game!
      _percentAlongAudioToShow: 0.506468
    - _text: "Sure sure, I\u2019m already working on fixing it, "
      _percentAlongAudioToShow: 0.59034675
    - _text: now please calm down!
      _percentAlongAudioToShow: 0.6630417
    - _text: "DON\u2019T YOU TELL ME TO CALM DOWN!"
      _percentAlongAudioToShow: 0.7093747
    - _text: 'THIS IS A SERIOUS ISSUE '
      _percentAlongAudioToShow: 0.7788743
    - _text: THAT COULD AFFECT THE RESULT OF THE ENTIRE TEST
      _percentAlongAudioToShow: 0.8451785
    - _text: There we go.
      _percentAlongAudioToShow: 0.9178734
    - _text: I just had to set a...
      _percentAlongAudioToShow: 0.9538215
