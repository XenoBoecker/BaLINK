  _lines:
  - _clip: {fileID: 8300000, guid: 8fba4a70a7795054290592a59a0eef56, type: 3}
    _segments:
    - _text: 'Ahh now I remember, '
      _percentAlongAudioToShow: 0
    - _text: 'they have to find clues to the code. '
      _percentAlongAudioToShow: 0.1756584
    - _text: "Somewhere in this wagon we\u2019ve hidden them, but where\u2026"
      _percentAlongAudioToShow: 0.4406905
  - _clip: {fileID: 8300000, guid: eed7d68b4b7486e4eafaca2597342e17, type: 3}
    _segments:
    - _text: 'OH YESS I remember! '
      _percentAlongAudioToShow: 0
    - _text: 'You wrote this crappy note with hints. '
      _percentAlongAudioToShow: 0.17990136
    - _text: They were so confusing and not at all helpful
      _percentAlongAudioToShow: 0.5065695
  - _clip: {fileID: 8300000, guid: 9f1b0e90839c461488d1579218cbcfb9, type: 3}
    _segments:
    - _text: "Ouch, thank you for that\u2026\r\n"
      _percentAlongAudioToShow: 0
    - _text: Anyways let me quickly check in the greybox where the clues are.
      _percentAlongAudioToShow: 0.29336485
